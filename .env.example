# cp .env.example .env — and for a deployment on localhost you can skip even
# that. Every value here has a working default.
#
# What is NOT here, on purpose: the API keys. They are set from Settings →
# Connections inside the running app and stored in the database, so there is no
# file to create before the app will start and no secret in your shell history.
# The variables below still work as bootstrap defaults if you prefer files —
# a stored value wins over them. See backend/app/runtime_config.py.


# --- The one thing worth setting ---------------------------------------------

# Where people actually reach this deployment, as they type it. Two things turn
# on it: the session cookie is marked `Secure` when this is https (on plain http
# a Secure cookie is never stored, and sign-in appears to silently do nothing),
# and it is the origin the app sends a browser back to after Google sign-in.
# PUBLIC_URL=https://feed.example.com

# Where to land after signing in, when PUBLIC_URL doesn't say. Left alone this
# assumes the Vite dev server, which is right for development and wrong for a
# container — set PUBLIC_URL instead of editing this.
# APP_ORIGIN=http://localhost:8000

# Host port. The container always listens on 8000.
# PORT=8000


# --- Who may sign in ----------------------------------------------------------

# By default: the first person to present the setup token becomes the owner, and
# after that nobody new can sign in on their own — you invite them from
# Settings → People, which hands you a link. That is the right default for a
# deployment with a public URL.
#
# Reopen it to anyone who can reach the server. Correct on a LAN, where the
# network is already the perimeter and a list of emails protects nothing.
# OPEN_SIGNUP=true

# Or name exactly who may sign in with Google, comma-separated. An explicit
# override: set this and it is the whole answer.
# ALLOWED_EMAILS=you@example.com,partner@example.com


# --- Paths and services -------------------------------------------------------

# Everything the app writes: database, downloads, thumbnails, OAuth token, the
# generated session key. The compose file sets this to /data and mounts a volume
# there. Locally it defaults to ./data.
# DATA_DIR=/data

# An external Meilisearch, if you'd rather not run the bundled one. Its key goes
# in Settings → Connections, not here.
# MEILI_URL=http://meili:7700

# Signs the session cookie. Leave it unset: one is generated into the data
# directory on first boot, so no deployment ships with a key its author knows.
# Set it only to share one key across several instances — and then it must be
# random, because anyone holding it can forge a signed-in cookie.
# SECRET_KEY=

# Bootstrap defaults for the keys that normally live in Settings. A value stored
# from the UI wins over these.
# OPENROUTER_API_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=


# --- Background jobs ----------------------------------------------------------

# How often channels are rescanned, in seconds (default 900).
# SCAN_INTERVAL_SECONDS=900

# Most channels the unattended daily resync will delete in one run before it
# refuses and asks to be run by hand. A truncated response from YouTube looks
# exactly like a mass unsubscribe, and the prune deletes those channels' videos.
# RESYNC_MAX_PRUNE=5
