{
  "manifest_version": 3,
  "name": "YT Feed — clean embed",
  "version": "1.0.0",
  "description": "Strips YouTube's overlays off embedded players so YT Feed can draw its own controls.",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/embed/*",
        "https://www.youtube-nocookie.com/embed/*"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "css": ["embed.css"]
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "all_frames": false,
      "run_at": "document_start",
      "js": ["marker.js"]
    }
  ]
}
